generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RequestStatus {
  DRAFT
  SUBMITTED
  ROUTING
  ASSIGNED
  UNDER_REVIEW
  AWAITING_FEE
  AWAITING_THIRD_PARTY
  TRANSFERRED
  DRAFTING_RESPONSE
  AWAITING_APPROVAL
  APPROVED
  RESPONSE_ISSUED
  CLOSED
  WITHDRAWN
}

enum ResponseFormat {
  electronic
  physical
}

enum UserRole {
  CITIZEN
  APIO
  DEALING_OFFICER
  PIO
  FIRST_APPELLATE_AUTHORITY
  DEPARTMENT_ADMIN
  PLATFORM_ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  passwordHash String?
  role         UserRole @default(CITIZEN)
  isActive     Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts    Account[]
  sessions    Session[]
  requests    RtiRequest[]
  memberships DepartmentMembership[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model RtiRequest {
  id              String @id @default(cuid())
  referenceNumber String @unique

  userId   String?
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName String
  email    String
  mobile   String
  address  String
  state    String
  district String
  pinCode  String

  departmentId   String
  subject        String
  description    String
  dateFrom       DateTime?      @db.Date
  dateTo         DateTime?      @db.Date
  responseFormat ResponseFormat

  status RequestStatus @default(SUBMITTED)

  createdAt     DateTime               @default(now())
  submittedAt   DateTime               @default(now())
  statusHistory RequestStatusHistory[]

  @@index([email])
  @@index([departmentId])
  @@index([status])
  @@index([createdAt])
  @@index([userId])
}

model RequestStatusHistory {
  id String @id @default(cuid())

  requestId String
  request   RtiRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  fromStatus RequestStatus?
  toStatus   RequestStatus

  remarks   String? @db.Text
  changedBy String?

  createdAt DateTime @default(now())

  @@index([requestId, createdAt])
  @@index([changedBy])
}

model Department {
  id        String   @id
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships DepartmentMembership[]
}

model DepartmentMembership {
  id           String   @id @default(cuid())
  userId       String
  departmentId String
  isActive     Boolean  @default(true)
  assignedAt   DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([userId, departmentId])
  @@index([userId])
  @@index([departmentId])
}
